PAPER2POD_MAX_SEGMENT_WORDS=
PAPER2POD_MAX_REGENERATIONS=
PAPER2POD_MAX_RETRIES=
PAPER2POD_DATA_DIR=
PAPER2POD_VOICES=
PAPER2POD_PAUSE_MS=
PAPER2POD_MAX_WORKERS=
PAPER2POD_LOG_LEVEL=
